# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Slack app (api.slack.com/apps -> install -> tokens) ---
SLACK_BOT_TOKEN=xoxb-...      # Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...      # App-Level Token, scope connections:write (Socket Mode)

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Your EXISTING Onsite managed agent (from the Anthropic console) ---
ONSITE_ENV_ID=
ONSITE_AGENT_ID=
ONSITE_AGENT_VERSION=
